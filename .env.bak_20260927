# LetterSys — متغيّرات البيئة المطلوبة
# انسخ هذا الملف إلى `.env` أو عرّف هذه المتغيّرات في النظام قبل تشغيل الخادم.
# لا تضع `.env` في Git (مضاف إلى .gitignore).

# ── سرّ Django ─────────────────────────────────────────────
# يجب تغييره في الإنتاج إلى قيمة عشوائية طويلة (>=50 حرفاً)
# توليد سريع:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# ── وضع التشغيل ────────────────────────────────────────────
# True في التطوير، False في الإنتاج (الافتراضي False)
DEBUG=True

# ── المضيفون المسموحون ────────────────────────────────────
# قائمة مفصولة بفواصل بدون مسافات
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://172.16.2.88:8001,http://192.168.137.1:8001

# ── قاعدة البيانات (PostgreSQL فقط) ───────────────────────
# يتطلب التطبيق PostgreSQL ولا يدعم SQLite كمسار تشغيل.
# شغّل activate_postgresql.bat مرة واحدة لإنشاء المستخدم وقاعدة البيانات.
DB_NAME=lettersys
DB_USER=lettersys_user
DB_PASSWORD=lettersys_pass
DB_HOST=localhost
DB_PORT=5432

# ── الكاش (Redis) ─────────────────────────────────────────
# اختياري في التطوير، مطلوب في الإنتاج للحصول على كاش مشترك بين العمّال
# مثال:
#   REDIS_CACHE_URL=redis://localhost:6379/1
# REDIS_CACHE_URL=

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── البريد الإلكتروني SMTP ─────────────────────────────────
# في DEBUG=True يستخدم console backend تلقائياً ولا يُرسل
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lettersys.local

# ── مزوّد الذكاء الاصطناعي ─────────────────────────────────
# offline | azure
AI_PROVIDER=offline
AI_FALLBACK_ON_LOW_CONFIDENCE=True
AI_LOW_CONFIDENCE_THRESHOLD=0.4
AI_ALLOW_MOCK_EXTRACTION=False
AI_AZURE_ENDPOINT=
AI_AZURE_KEY=

# ── محرّك OCR المحلّي (Tesseract — خفيف/سريع، بلا PyTorch) ──
AI_OFFLINE_ENGINE=tesseract
# مجلّد ملفّات اللغة (ara/eng) — لازم لتحميل العربية فعلياً
TESSERACT_TESSDATA_DIR=C:\Users\fwz\tessdata
# TESSERACT_CMD فارغ = اكتشاف تلقائي (يشمل نسخة NAPS2 المضمّنة)
TESSERACT_LANG=ara+eng

# الاستخراج التلقائي عند المسح: مُفعَّل — Tesseract خفيف ويعمل داخل العملية (سبب
# التعطيل السابق كان EasyOCR الثقيل، وقد استُبدِل). عطّله بـ False لإدخال يدوي.
SCAN_AUTO_OCR=True

# ── الماسح الضوئي ─────────────────────────────────────────
SCAN_SIMULATOR_MODE=False
SCAN_SIMULATOR_DELAY=3

# ── إعدادات أمنية إضافية للإنتاج ───────────────────────────
# تُطبَّق فقط عندما DEBUG=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── إعدادات الذاكرة والحجم ──────────────────────────────
# لتعطيل ScanWatcher (يوفر RAM لو لم تستخدم الماسح يومياً)
SCAN_WATCHER_ENABLED=True
# media منقولة إلى D:\ لتوفير 13.7 GB
MEDIA_ROOT=D:\lettersys_data\media
# عدم تحميل EasyOCR عند بدء السيرفر (افتراضي: False)
AI_PRELOAD_OCR=False

# ── ملاحظات ─────────────────────────────────────────────
# - عند النقل لخادم Linux في الإنتاج، أنشئ القاعدة بـ:
#     CREATE DATABASE lettersys WITH ENCODING='UTF8'
#         LC_COLLATE='C.UTF-8' LC_CTYPE='C.UTF-8' TEMPLATE=template0;
# - أمتداد pg_trgm يُفعَّل تلقائياً بواسطة migration 0019.
# - بعد كل deploy نفّذ:  python manage.py migrate && python manage.py collectstatic
RESERVATION_EXPIRE_MINUTES=45

# اعتماد SQL Server لاستعادة/دمج قاعدة ARCHMDOC القديمة (كان مكتوباً في القالب)
LEGACY_SQL_PASSWORD=Migrate@2026!
