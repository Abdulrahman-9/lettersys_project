# LetterSys — متغيّرات البيئة المطلوبة
# انسخ هذا الملف إلى `.env` أو عرّف هذه المتغيّرات في النظام قبل تشغيل الخادم.
# لا تضع `.env` في Git (مضاف إلى .gitignore).

# ── سرّ Django ─────────────────────────────────────────────
# يجب تغييره في الإنتاج إلى قيمة عشوائية طويلة (>=50 حرفاً)
# توليد سريع:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# ── وضع التشغيل ────────────────────────────────────────────
# True في التطوير، False في الإنتاج (الافتراضي False)
DEBUG=True

# ── المضيفون المسموحون ────────────────────────────────────
# قائمة مفصولة بفواصل بدون مسافات
ALLOWED_HOSTS=localhost,127.0.0.1,172.16.2.209
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://172.16.2.209:8000

# ── قاعدة البيانات (PostgreSQL فقط) ───────────────────────
# يتطلب التطبيق PostgreSQL ولا يدعم SQLite كمسار تشغيل.
# شغّل activate_postgresql.bat مرة واحدة لإنشاء المستخدم وقاعدة البيانات.
DB_NAME=lettersys
DB_USER=lettersys_user
DB_PASSWORD=lettersys_pass
DB_HOST=localhost
DB_PORT=5432

# ── الكاش (Redis) ─────────────────────────────────────────
# اختياري في التطوير، مطلوب في الإنتاج للحصول على كاش مشترك بين العمّال
# مثال:
#   REDIS_CACHE_URL=redis://localhost:6379/1
# REDIS_CACHE_URL=

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── البريد الإلكتروني SMTP ─────────────────────────────────
# في DEBUG=True يستخدم console backend تلقائياً ولا يُرسل
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lettersys.local

# ── مزوّد الذكاء الاصطناعي ─────────────────────────────────
# offline | azure
AI_PROVIDER=offline
AI_FALLBACK_ON_LOW_CONFIDENCE=True
AI_LOW_CONFIDENCE_THRESHOLD=0.4
AI_ALLOW_MOCK_EXTRACTION=False
AI_AZURE_ENDPOINT=
AI_AZURE_KEY=

# ── الماسح الضوئي ─────────────────────────────────────────
SCAN_SIMULATOR_MODE=False
SCAN_SIMULATOR_DELAY=3

# ── إعدادات أمنية إضافية للإنتاج ───────────────────────────
# تُطبَّق فقط عندما DEBUG=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── ملاحظات ─────────────────────────────────────────────
# - عند النقل لخادم Linux في الإنتاج، أنشئ القاعدة بـ:
#     CREATE DATABASE lettersys WITH ENCODING='UTF8'
#         LC_COLLATE='C.UTF-8' LC_CTYPE='C.UTF-8' TEMPLATE=template0;
# - أمتداد pg_trgm يُفعَّل تلقائياً بواسطة migration 0019.
# - بعد كل deploy نفّذ:  python manage.py migrate && python manage.py collectstatic

# ─── عتادُ النماذج و OCR ──────────────────────────────────────────────────────
# كلُّها اختياريّة: الفارغُ يعني «جذرُ المشروع + المسارُ المعتاد» عبر
# core/extraction/artifacts.py. تحقّقْ دائماً بـ:
#   python manage.py models_healthcheck --strict --load
# مسارُ محرّك tesseract — فارغٌ يعني كشفاً تلقائيّاً (Program Files ثمّ NAPS2 ثمّ PATH)
TESSERACT_CMD=
# مجلّد بيانات اللغة (يجب أن يضمّ ara.traineddata و eng.traineddata) — بلا العربيّة لا استخراج
TESSERACT_TESSDATA_DIR=
TESSERACT_LANG=ara+eng
# تجاوزاتُ مسارات الأوزان (نادرة — للنشر على قرصٍ آخر)
NUMBER_DETECTOR_ONNX=
NUMBER_DETECTOR_FALLBACK_ONNX=
HANDWRITTEN_NUMBER_ONNX=
HANDWRITTEN_NUMBER_CHARSET=
HANDWRITTEN_DATE_ONNX=
HANDWRITTEN_DATE_CHARSET=

# ─── النشرُ خلف وكيلٍ عكسيّ (nginx) ───────────────────────────────────────────
# الافتراضاتُ آمنة؛ هذه القيمُ للمرحلة الانتقاليّة قبل إصدار شهادة TLS فقط،
# وتُرفَع فورَ إصدارها (بند «إعادةُ الكوكيز إلى Secure» في دليل التدشين).
#   SESSION_COOKIE_SECURE=False
#   CSRF_COOKIE_SECURE=False
#   SECURE_SSL_REDIRECT=False
# ويبقى هذا True في النشر خلف nginx (والتطبيقُ غيرُ مكشوفٍ مباشرةً):
USE_X_FORWARDED_PROTO=True
# النطاقاتُ المسموحة وأصولُ CSRF — تُضبط عند ربط الدومين
# ALLOWED_HOSTS=lettersys.online,www.lettersys.online
# CSRF_TRUSTED_ORIGINS=https://lettersys.online,https://www.lettersys.online
